APP_NAME="Sunu Atelier"
APP_ENV=production
APP_KEY=base64:REMPLACER_PAR_CLE_GENEREE_EN_LOCAL
APP_DEBUG=false
APP_URL=https://votre-sous-domaine.infinityfreeapp.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Dakar

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=single
LOG_LEVEL=error

# Base de données MySQL InfinityFree (voir panneau vPanel -> MySQL Databases)
DB_CONNECTION=mysql
DB_HOST=sqlXXX.infinityfree.com
DB_PORT=3306
DB_DATABASE=if0_XXXXXXXX_sunu_atelier
DB_USERNAME=if0_XXXXXXXX
DB_PASSWORD=VOTRE_MOT_DE_PASSE_MYSQL

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

# SMTP gratuit recommandé (Brevo, Mailjet, Gmail App Password)
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=votre-email@exemple.com
MAIL_PASSWORD=votre-cle-smtp
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="contact@sunu-atelier.sn"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
